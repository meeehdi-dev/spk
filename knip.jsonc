{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    // MDC renders components by name; settings use resolveComponent().
    "app/components/mdc/**/*.vue",
    "app/components/settings/**/*.vue",
    // The PWA worker source is relative to Vite's app root.
    "service-worker/sw.js",
  ],
  "ignoreDependencies": [
    // Nuxt invokes vue-tsc through its CLI.
    "vue-tsc",
  ],
}
