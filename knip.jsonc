{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "entry": [
    // MDC renders components by name; settings use resolveComponent().
    "app/components/mdc/**/*.vue",
    "app/components/settings/**/*.vue",
    // Selected through development-only aliases and Nuxt hooks, not static application imports.
    "dev/ui/{auth,voice,socket,plugin,panel-plugin}.ts",
    "dev/ui/server/**/*.ts",
    // The PWA worker source is relative to Vite's app root.
    "service-worker/sw.js",
    // Standalone Electron wrapper with its own package.json.
    "integrations/electron/{*.js,*.cjs,scripts/*.mjs}",
  ],
  // macOS system tools used by integrations/electron/scripts/start.mjs.
  "ignoreBinaries": ["sips"],
  "ignoreDependencies": [
    // Provided by integrations/electron/package.json, which is outside the workspace.
    "electron",
    "uiohook-napi",
    // Nuxt invokes vue-tsc through its CLI.
    "vue-tsc",
  ],
}
