# Copy to .env (git-ignored) and fill in. Nuxt maps NUXT_* vars onto runtimeConfig.

# Session signing secret (better-auth). Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public app URL (better-auth). Dev: http://localhost:3000
BETTER_AUTH_URL=https://chat.example.com

# SQLite file. Prod: /app/data/spk.db
NUXT_DATABASE_PATH=./data/spk.db

# Cloudflare R2 account id (Cloudflare dashboard)
NUXT_R2_ACCOUNT_ID=
# R2 API token with Object Read & Write on the bucket (R2 > Manage API tokens)
NUXT_R2_ACCESS_KEY_ID=
NUXT_R2_SECRET_ACCESS_KEY=
# R2 bucket name
NUXT_R2_BUCKET=spk

# LiveKit WebSocket URL used by the browser. Dev: ws://localhost:7880
NUXT_PUBLIC_LIVEKIT_URL=wss://rtc.chat.example.com
# LiveKit key/secret for signing tokens; must match the LiveKit server's `keys`.
# Secret: openssl rand -base64 32. Dev mode (livekit-server --dev): devkey / secret
NUXT_LIVEKIT_API_KEY=
NUXT_LIVEKIT_API_SECRET=

# Web Push VAPID keys. Generate: pnpm dlx web-push generate-vapid-keys
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
NUXT_VAPID_PRIVATE_KEY=
# Web Push contact, e.g. mailto:you@example.com
NUXT_VAPID_SUBJECT=

# Klipy API key for the GIF proxy (Klipy dashboard)
NUXT_KLIPY_API_KEY=
